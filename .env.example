# Server-side secrets only; never use NEXT_PUBLIC_ for these.
# Option A: original Groq free-tier setup. Leave OPENAI_* credentials blank.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Option B: any OpenAI-compatible Chat Completions provider.
# Takes priority over Groq when key, base URL or model is supplied.
OPENAI_API_KEY=
# Leave blank to use https://api.openai.com/v1; otherwise use the provider's API base.
OPENAI_BASE_URL=
# Required with Option B: copy an exact model ID from your provider.
OPENAI_MODEL=
# Optional public label shown to students (not a secret).
OPENAI_PROVIDER_NAME=
# Set false if the provider does not accept response_format.
OPENAI_JSON_MODE=true
# Set max_tokens for providers that do not accept max_completion_tokens.
OPENAI_TOKEN_PARAMETER=max_completion_tokens

# Independent web search / public link extraction:
TAVILY_API_KEY=
# Optional persistent rate limiter for multi-instance production:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
